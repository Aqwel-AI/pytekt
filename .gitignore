# Aqwel PyTekt — safe defaults for open source (never commit secrets or local state)
# Run: git status --ignored   to audit

# Python
# ------
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.so
**/*.pyd
.Python
*.egg
**/.eggs/
**/*.egg-info/
**/*.egg

# Native extension (built locally per machine)
# -----------------------------------------
pytekt/_pytekt_core*.so
pytekt/_pytekt_core*.pyd
pytekt/_pytekt_core*.so
pytekt/_pytekt_core*.pyd

# Build & packaging
# -----------------
build/
dist/
*.manifest
*.spec

# Virtual environments (root only — do not ignore pytekt/env package)
# ----------------------------------------------------------------
/.venv/
/venv/
/env/
/ENV/
.nox/
.tox/

# Secrets & credentials (NEVER commit)
# ------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
credentials/
secrets/
**/secrets/
id_rsa
id_rsa.*
*.secret

# User config (API keys, agent prefs — lives on your machine only)
# -----------------------------------------------------------------
.pytekt.yaml
.pytekt.yml
.pytekt/
.pytekt.yaml
.pytekt.yml
.pytekt/
**/.pytekt.yaml
**/.pytekt.yaml
*.local.yaml
*.local.yml
*.local.toml
config.local.*

# IDE / editor / AI assistants
# ----------------------------
.idea/
.vscode/
.cursor/
*.swp
*.swo
*~

# OS
# --
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# Testing & quality
# -------------------
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
**/.ipynb_checkpoints/

# Logs & temp
# -----------
*.log
logs/
*.tmp
*.temp
*.bak

# ML / research artifacts (local experiments)
# -------------------------------------------
wandb/
mlruns/
runs/
tensorboard/
tensorboard_logs/
lightning_logs/
checkpoints/
checkpoint/
*.ckpt
*.pt
*.pth
*.onnx
*.safetensors
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
data/raw/
data/private/
datasets/private/
private_data/
experiments/local/

# Local SQLite / agent caches
# ---------------------------
*.sqlite
*.sqlite3
.pytekt_cache/
.pytekt_store/
.pytekt_cache/
.pytekt_store/
**/.pytekt/usage/events.jsonl
**/.pytekt/usage/events.jsonl
**/node_modules/
pytekt/usage/web/dist/
pytekt/usage/web/dist/
.agent/

# Generated output (regenerate locally; do not push)
# --------------------------------------------------
example_output/
pytekt/former/examples_results/*.png
pytekt/former/examples_results/*.png

# Legacy empty package dirs (use pytekt/cli_agent/ and code.py only)
# ---------------------------------------------------------------
pytekt/agent/
pytekt/code/

# Archived code (kept locally, not shipped)
# -----------------------------------------
archived/

# Scratch / accidental
# --------------------
text.txt
LICENSE copy
scratch/
tmp/

# R build artifacts
# -----------------
*.Rcheck/
r_pytekt/src/*.o
r_pytekt/src/*.so
r_pytekt/src/*.dll
r_pytekt/src/symbols.rds
.Rhistory
.RData
