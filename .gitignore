# Aqwel Aion — safe defaults for open source (never commit secrets or local state)
# Run: git status --ignored   to audit

# Python
# ------
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.so
**/*.pyd
.Python
*.egg
**/.eggs/
**/*.egg-info/
**/*.egg

# Native extension (built locally per machine)
# -----------------------------------------
aion/_aion_core*.so
aion/_aion_core*.pyd

# Build & packaging
# -----------------
build/
dist/
*.manifest
*.spec

# Virtual environments
# --------------------
.venv/
venv/
env/
ENV/
.nox/
.tox/

# Secrets & credentials (NEVER commit)
# ------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
credentials/
secrets/
**/secrets/
id_rsa
id_rsa.*
*.secret

# User Aion config (API keys, agent prefs — lives on your machine only)
# ---------------------------------------------------------------------
.aion.yaml
.aion.yml
.aion/
**/.aion.yaml
*.local.yaml
*.local.yml
*.local.toml
config.local.*

# IDE / editor / AI assistants
# ----------------------------
.idea/
.vscode/
.cursor/
*.swp
*.swo
*~

# OS
# --
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# Testing & quality
# -------------------
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
**/.ipynb_checkpoints/

# Logs & temp
# -----------
*.log
logs/
*.tmp
*.temp
*.bak

# ML / research artifacts (local experiments)
# -------------------------------------------
wandb/
mlruns/
runs/
tensorboard/
tensorboard_logs/
lightning_logs/
checkpoints/
checkpoint/
*.ckpt
*.pt
*.pth
*.onnx
*.safetensors
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
data/raw/
data/private/
datasets/private/
private_data/
experiments/local/

# Local SQLite / agent caches
# ---------------------------
*.sqlite
*.sqlite3
.aion_cache/
.aion_store/
**/.aion/usage/events.jsonl
aion/usage/web/node_modules/
aion/usage/web/dist/
.agent/

# Generated output (regenerate locally; do not push)
# --------------------------------------------------
example_output/
aion/former/examples_results/*.png

# Legacy empty package dirs (use aion/cli_agent/ and code.py only)
# ---------------------------------------------------------------
aion/agent/
aion/code/

# Archived code (kept locally, not shipped)
# -----------------------------------------
archived/

# Scratch / accidental
# --------------------
text.txt
LICENSE copy
scratch/
tmp/
