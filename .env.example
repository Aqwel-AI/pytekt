# Aion — environment variable template (copy to .env for local dev only)
# =============================================================================
# NEVER commit a real .env file. Copy this file:
#   cp .env.example .env
# Then fill in your own keys. .env is listed in .gitignore.
#
# Alternative: store keys via CLI (written to ~/.aion.yaml, not in this repo):
#   aion api add Gemini YOUR_KEY
#   aion api add OpenAI YOUR_KEY

# --- LLM providers (use the ones you need) ---
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=

# --- Ollama (local; usually no key) ---
# OLLAMA_HOST=http://localhost:11434

# --- CLI / UI ---
# NO_COLOR=1
# AION_NO_SPLASH=1

# --- Optional: override config path (default: ~/.aion.yaml) ---
# AION_CONFIG_PATH=~/.aion.yaml
